# Copy this file to .env and fill in your values

# Backend
PORT=8000

# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# Stripe (test mode keys from dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # only needed if running the webhook
FRONTEND_URL=http://localhost:3000     # where Stripe redirects after checkout

# Frontend (prefix with NEXT_PUBLIC_ to expose to the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # for the frontend teammate

# Email settings
EMAIL_BACKEND = 
EMAIL_HOST = 
EMAIL_PORT = 
EMAIL_USE_TLS = 

EMAIL_HOST_USER = 
EMAIL_HOST_PASSWORD = 

